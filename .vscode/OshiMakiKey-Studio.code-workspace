{
  "folders": [
    {
      "name": "OshiMakiKey Studio",
      "path": "../"
    }
  ],
  "settings": {
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.exclude": {
      "**/bin": true,
      "**/obj": true,
      "publish": true,
      ".vs/.vs": true
    },
    "search.exclude": {
      "user_data": true,
      "**/bin": true,
      "**/obj": true
    },
    "dotnet.defaultSolution": ".vs/OshiMakiKey-Studio.sln",
    "[csharp]": {
      "editor.tabSize": 4,
      "editor.insertSpaces": true
    },
    "[json]": {
      "editor.tabSize": 2
    }
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csdevkit",
      "ms-dotnettools.csharp",
      "ms-dotnettools.vscode-dotnet-runtime",
      "ms-vscode.powershell",
      "editorconfig.editorconfig"
    ]
  }
}
